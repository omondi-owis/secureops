# =====================================================================
# SecureOps configuration
# Copy this file to `.env` and change every value marked CHANGE_ME.
# NEVER commit `.env` to version control.
# =====================================================================

APP_NAME=SecureOps
APP_ENV=development          # development | testing | production
# SECRET_KEY must be a long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Set to true when serving over HTTPS (behind Nginx with TLS)
COOKIE_SECURE=false
SESSION_COOKIE_NAME=secureops_session

# PostgreSQL connection string (SQLAlchemy / psycopg v3 format)
DATABASE_URL=postgresql+psycopg://secureops:CHANGE_ME_DB_PASSWORD@localhost:5432/secureops

# Initial admin account, used by `python -m app.cli create-admin`
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@secureops.local
DEFAULT_ADMIN_PASSWORD=CHANGE_ME

# ---- Wazuh manager (external) ---------------------------------------
WAZUH_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_VERIFY_SSL=false
WAZUH_TIMEOUT=10

# ---- Authorized scanning scope --------------------------------------
# Comma separated CIDR list. The scanner will refuse anything outside it.
AUTHORIZED_CIDRS=127.0.0.1/32,192.168.187.0/24

# ---- Log sources -----------------------------------------------------
LOG_AUTH_PATH=/var/log/auth.log
LOG_SYSLOG_PATH=/var/log/syslog
# Set false if journalctl is unavailable on the host
LOG_JOURNALCTL_AVAILABLE=true
LOG_MAX_LINES=5000

# ---- Nmap ------------------------------------------------------------
NMAP_PATH=/usr/bin/nmap
NMAP_ENABLED=true
NMAP_TIMEOUT=300

# ---- Rate limiting ---------------------------------------------------
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# ---- AI / autonomy (SecureOps AI) ------------------------------------
# Provider: disabled | ollama | openai_compatible
#   disabled          — deterministic rules only; AI features stay off
#   ollama            — local Ollama server (default http://localhost:11434)
#   openai_compatible — any OpenAI-compatible endpoint (LM Studio, vLLM, …)
AI_PROVIDER=disabled
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=1500

# Autonomy mode: OBSERVE | ASSIST | CONTROLLED_AUTONOMY | EMERGENCY_LOCKDOWN
#   OBSERVE             — analysis/recommendations only; never acts
#   ASSIST              — proposes actions; always needs human approval
#   CONTROLLED_AUTONOMY — pre-defined LOW-RISK actions may auto-execute
#   EMERGENCY_LOCKDOWN  — read-only investigation tools only
AUTONOMY_MODE=OBSERVE

# Guardrails
AI_MAX_AUTONOMOUS_ACTIONS_PER_HOUR=10
AI_MAX_CONCURRENT_ACTIONS=2
AI_ACTION_TIMEOUT_SECONDS=60
AI_COOLDOWN_MINUTES=5
SOC_LOOP_INTERVAL_SECONDS=30
# EMERGENCY_STOP=true blocks all autonomous/non-read-only AI actions
EMERGENCY_STOP=true
